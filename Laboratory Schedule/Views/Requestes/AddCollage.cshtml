@model Laboratory_Schedule.Models.Collages

<div class="row bg-info my-3 mx-2 rounded ">
    <h5 class="text-light text-center">Add Collage</h5>
</div>

<form asp-action="AddCollage" asp-controller="Requestes" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken() 
    
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <!--first row-->
    <div class="row">
        <div class="col">
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Collage Name</label>
                <input asp-for="Name" class="form-control" required placeholder="Enter collage name..." />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col">
            <div class="form-group">
                <input type="submit" value="Submit" class="btn btn-primary float-end" />
            </div>
        </div>
    </div>
</form>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>
